# Copy to .env.local and fill in what you have. Everything is optional:
# without keys the dashboard still runs on simulated weather and keyword search.

# Google AI Studio key for AI insights and natural-language search (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Gemini model to use (default gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Optional: WeatherAPI.com key for live current weather (https://www.weatherapi.com/)
WEATHER_API_KEY=
